{
  "configVersion": "time-checker-otp-1",
  "server": {
    "apiProcessingTimeout": "PT3M"
  },
  "routingDefaults": {
    "walkSpeed": 1.42,
    "walkReluctance": 1.0,
    "stairsReluctance": 1.65,
    "escalatorReluctance": 1.0,
    "waitReluctance": 1.0,
    "transferSlack": 15,
    "boardSlackForMode": {
      "SUBWAY": "PT15S"
    },
    "alightSlackForMode": {
      "SUBWAY": "PT15S"
    },
    "accessEgress": {
      "maxDuration": "PT45M",
      "maxStopCount": 500
    },
    "streetRoutingTimeout": "PT30S",
    "maxJourneyDuration": "PT3H"
  }
}
